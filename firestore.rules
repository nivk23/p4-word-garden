rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only access their own documents
    match /users/{uid} {
      allow read, write: if request.auth.uid == uid;

      // Allow access to all subcollections
      match /{document=**} {
        allow read, write: if request.auth.uid == uid;
      }
    }
  }
}
